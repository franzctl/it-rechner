<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F2F3F5"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleTextColor="#1A1A1A"
        android:background="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zahl oder Zeichen"
        android:textSize="12sp"
        android:textColor="#8A90A8" />

    <EditText
        android:id="@+id/feldAscii"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:textColor="#1A1A1A"
        android:padding="12dp"
        android:inputType="text"
        android:hint="65"
        android:autofillHints=""/>

    <Button
        android:id="@+id/knopfUmrechnen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Umrechnen" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/ausgabeAscii"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="#1A1A1A"
            android:textIsSelectable="true"
            android:contentDescription="Ergebnis der Umrechnung" />
    </ScrollView>
</LinearLayout>