<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/hintergrund"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextColor="@color/text"
        android:background="@color/flaeche" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IP-Adresse"
        android:textSize="12sp"
        android:textColor="@color/text_leise" />

    <EditText
        android:id="@+id/feldIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/flaeche"
        android:textColor="@color/text"
        android:padding="12dp"
        android:inputType="text"
        android:hint="192.168.178.10"
        android:autofillHints=""/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Präfix oder Maske"
        android:textSize="12sp"
        android:textColor="@color/text_leise" />

    <EditText
        android:id="@+id/feldPraefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/flaeche"
        android:textColor="@color/text"
        android:padding="12dp"
        android:inputType="number|numberDecimal"
        android:digits="0123456789./"
        android:hint="24 oder 255.255.255.0"
        android:autofillHints=""/>

    <Button
        android:id="@+id/knopfRechnen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Netz berechnen" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@color/flaeche">

        <TextView
            android:id="@+id/ausgabe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:contentDescription="Ergebnis der Netzberechnung" />
    </ScrollView>
</LinearLayout>